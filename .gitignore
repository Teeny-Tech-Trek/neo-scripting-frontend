# ──────────────────────────────────────────────────────────────────────────
# Neo Scripting frontend — .gitignore
#
# Vite + React + TypeScript + Tailwind. Standard Vite output goes to dist/.
# Any VITE_* env var is baked into the bundle at build time and is public,
# but we still ignore .env files so:
#   1. nobody accidentally commits a different env (test/staging) over yours
#   2. .env stays the source of truth for local dev; CI/CD set vars in
#      the platform dashboard (Vercel) instead
# ──────────────────────────────────────────────────────────────────────────

# ── Env files (commit only the .example) ────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging
.env.test
# Keep templates checked in so future-you / colleagues see what to set:
!.env.example

# ── Dependencies ────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# ── Build output ────────────────────────────────────────────────────────
dist/
dist-ssr/
build/
# Vite type-check artifact (tsc --noEmit produces this when isolatedModules
# is on). Re-generated on every build; pointless to track.
*.tsbuildinfo
# Vercel local artifacts. The .vercel folder holds project metadata; safe
# to ignore even though it's small.
.vercel/

# ── Logs ────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Editor / OS ─────────────────────────────────────────────────────────
.vscode/*
# Keep team-wide editor settings + recommended extensions list:
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# ── Local overrides ─────────────────────────────────────────────────────
# *.local lets devs scratch files (e.g. notes.local.md) without git ever
# offering them up. Inherited from the Vite template — useful pattern.
*.local

# ── Coverage + test artifacts ───────────────────────────────────────────
coverage/
.nyc_output/

# ── Misc ────────────────────────────────────────────────────────────────
# Browser test downloads, screenshot artifacts, etc.
test-results/
playwright-report/
playwright/.cache/
