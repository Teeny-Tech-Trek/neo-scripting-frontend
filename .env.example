# Vite environment — copy to .env and fill in.
# All VITE_* vars are baked into the bundle at build time and are PUBLIC.
# Never put a secret here.

# Node auth service (issues JWTs, handles login/register/refresh).
VITE_API_BASE_URL=http://localhost:3000

# Python FastAPI (the generation pipeline + everything user-facing).
VITE_AI_API_URL=http://localhost:8000

# MCP server SSE endpoint. Only used by the dashboard's "Server online"
# badge — actual MCP traffic flows from Claude Desktop, not the browser.
VITE_MCP_URL=http://localhost:8080/sse

# Google OAuth client ID — public by design.
VITE_GOOGLE_CLIENT_ID=

# Razorpay public key — only used as a *fallback* if the FastAPI /billing/plans
# response doesn't echo the key. Normally the server provides it; this is
# here so the frontend can still open Checkout in dev if FastAPI's
# RAZORPAY_KEY_ID is unset. Public-by-design (Razorpay's "key_id" is public).
VITE_RAZORPAY_KEY_ID=
